{
  "id": "com.orange.bridge",
  "name": "来福桥接",
  "version": "1.0.77",
  "main": "index.html",
  "manifestVersion": 6,
  "host": {
    "app": "PS",
    "minVersion": "23.3.0",
    "data": {
      "loadEvent": "startup"
    }
  },
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess"
  },
  "icons": [
    { "width": 23, "height": 23, "path": "garment-panel.png", "scale": [1, 2], "theme": ["all"], "species": ["generic", "pluginList"] }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "lifeGarmentRetouch",
      "label": { "default": "服装精修" },
      "minimumSize": { "width": 220, "height": 170 },
      "maximumSize": { "width": 1200, "height": 2000 },
      "preferredDockedSize": { "width": 265, "height": 480 },
      "preferredFloatingSize": { "width": 285, "height": 480 },
      "icons": [
        { "width": 23, "height": 23, "path": "garment-panel.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "garment-panel.png", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ]
}